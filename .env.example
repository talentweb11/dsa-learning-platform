# Public frontend configuration (never put judge credentials in VITE_ variables)
VITE_RUNNER_URL=http://localhost:8787
# Server-only configuration
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JUDGE0_URL=https://your-private-judge.example.com
JUDGE0_AUTH_TOKEN=
# Set only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Judge0 CE IDs; confirm against your instance /languages endpoint.
JUDGE_LANGUAGE_PYTHON=71
JUDGE_LANGUAGE_JAVA=62
JUDGE_LANGUAGE_CPP=54
JUDGE_LANGUAGE_JAVASCRIPT=63
